# ============================================
# NESTJS BACKEND TEMPLATE - ENVIRONMENT EXAMPLE
# ============================================
# Copy this file to .env and fill in the values.
# In production, ensure all sensitive variables are set.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development                             # development, production, test, staging
PORT=3000                                        # Port for the server to listen on
API_PREFIX=api/v1                                # API version prefix
APP_NAME="WP-AUTOMATION-BACKEND"                   # Application name
APP_URL=http://localhost:3000                    # Base URL for the application

# ============================================
# DATABASE (Supabase / PostgreSQL)
# ============================================
# Format: postgresql://user:password@host:port/database
# For Supabase, use the transaction connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Supabase, use the session connection string (port 5432) for DIRECT_URL (migrations/introspection)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection Pool Settings
DB_POOL_MIN=1                                    # Min connections (Supabase default is small)
DB_POOL_MAX=10                                   # Max connections
DB_POOL_IDLE_TIMEOUT=30000                       # Idle timeout in ms

# ============================================
# JWT SECURITY
# ============================================
# Use strong, random secrets in production (min 32 chars)
JWT_SECRET=your_32_character_long_access_secret_here
JWT_EXPIRATION=15m                               # Access token expiry (e.g., 15m, 1h)
JWT_REFRESH_SECRET=your_32_character_long_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d                        # Refresh token expiry (e.g., 7d, 30d)
JWT_ISSUER=backend-api
JWT_AUDIENCE=backend-client

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
MAX_LOGIN_ATTEMPTS=5                             # Max failed attempts before lockout
ACCOUNT_LOCK_DURATION=1800000                    # Lock duration in ms (default: 30 min)
FAILED_LOGIN_RESET_TIME=900000                   # Reset failed count after ms (default: 15 min)

PASSWORD_RESET_TOKEN_EXPIRY=3600000              # Token expiry in ms (default: 1 hour)
PASSWORD_RESET_MAX_ATTEMPTS=3                    # Max reset attempts
BCRYPT_ROUNDS=12                                 # salt rounds (10-15)

MAX_SESSIONS_PER_USER=5                          # Max concurrent devices per user

# ============================================
# RATE LIMITING (Auth Protection)
# ============================================
AUTH_SENSITIVE_LIMIT=5                           # Per 15min window (Login, Reset)
AUTH_SENSITIVE_TTL=900000                        
AUTH_REFRESH_LIMIT=10                            # Per 1min window
AUTH_REFRESH_TTL=60000                           
AUTH_REGISTER_LIMIT=3                            # Per 1hour window
AUTH_REGISTER_TTL=3600000                        

# ============================================
# CORS
# ============================================
# Comma-separated list for production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOWED_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
ALLOWED_HEADERS="Content-Type,Authorization,X-Request-ID"
CREDENTIALS=true

# ============================================
# REDIS (Caching & WS Scaling)
# ============================================
REDIS_ENABLED=false
REDIS_TLS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0                                       # Primary cache DB
REDIS_TTL=3600                                   # Cache TTL in seconds
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info                                   # error, warn, info, debug, etc.
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_ERROR_FILE_PATH=logs/error.log
LOG_MAX_SIZE=20m                                 # Max size per file
LOG_MAX_FILES=14d                                # Retention duration
LOG_COMPRESS=true

# Sentry (Optional Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# WEBSOCKET
# ============================================
WEBSOCKET_CORS_ORIGIN=http://localhost:5173
WS_PING_TIMEOUT=30000
WS_PING_INTERVAL=25000
WS_REDIS_ENABLED=false                           # Enable for horizontal scaling
WS_REDIS_DB=1                                    # Dedicated DB index for Pub/Sub

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PHONE_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_AUDIT_LOGGING=true

# ============================================
# SEEDING (Initial Super Admin)
# ============================================
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_FULL_NAME="Super Admin"
SEED_ADMIN_ADDRESS="Optional Address"
SEED_ADMIN_PHONE_NO="+94771234567"

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
# SMS (Twilio/AWS)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# AWS (S3 / SNS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# APM (Elastic/NewRelic)
APM_ENABLED=false
APM_SERVER_URL=
APM_SERVICE_NAME=backend-api
WP-AUTOMATION@123