# ============================================
# WP-AUTOMATION-BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in the values.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development                             # development, production, test, staging
PORT=3000                                        # Port for the server to listen on
API_PREFIX=api/v1                                # API version prefix
APP_NAME="WP-AUTOMATION-BACKEND"                 # Application name
APP_URL=http://localhost:3000                    # Base URL for the application

# ============================================
# DATABASE (Supabase / PostgreSQL)
# ============================================
# Transaction connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session connection string (port 5432) for DIRECT_URL (migrations/seeding)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection Pool Settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# ============================================
# JWT & APP SECURITY
# ============================================
ENCRYPTION_KEY=wp_automation_secure_aes_encryption_key_32_chars
JWT_SECRET=your_32_character_long_access_secret_here
JWT_EXPIRATION=15m                               # Access token expiry (e.g., 15m, 1h)
JWT_REFRESH_SECRET=your_32_character_long_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d                        # Refresh token expiry (e.g., 7d, 30d)
JWT_ISSUER=wp-automation-api
JWT_AUDIENCE=wp-automation-client

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
MAX_LOGIN_ATTEMPTS=5                             # Max failed attempts before lockout
ACCOUNT_LOCK_DURATION=1800000                    # Lock duration in ms (default: 30 min)
FAILED_LOGIN_RESET_TIME=900000                   # Reset failed count after ms (default: 15 min)
PASSWORD_RESET_TOKEN_EXPIRY=3600000              # Token expiry in ms (default: 1 hour)
BCRYPT_ROUNDS=12                                 # Salt rounds (10-15)
MAX_SESSIONS_PER_USER=5                          # Max concurrent devices per user

# ============================================
# RATE LIMITING (Auth Protection)
# ============================================
AUTH_SENSITIVE_LIMIT=5                           # Per 15min window (Login, Reset)
AUTH_SENSITIVE_TTL=900000                        
AUTH_REFRESH_LIMIT=10                            # Per 1min window
AUTH_REFRESH_TTL=60000                           
AUTH_REGISTER_LIMIT=3                            # Per 1hour window
AUTH_REGISTER_TTL=3600000                        

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOWED_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
ALLOWED_HEADERS="Content-Type,Authorization,X-Request-ID"
CREDENTIALS=true

# ============================================
# EMAIL / SMTP (Nodemailer)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@wpautomation.com
MAIL_FROM_NAME="WP-AUTOMATION-BACKEND"
SMTP_SECURE=false

# ============================================
# REDIS (Optional Caching & WS Scaling)
# ============================================
REDIS_ENABLED=false
REDIS_TLS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info                                   # error, warn, info, debug
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_ERROR_FILE_PATH=logs/error.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_COMPRESS=true

# ============================================
# WEBSOCKET
# ============================================
WEBSOCKET_CORS_ORIGIN=http://localhost:5173
WS_PING_TIMEOUT=30000
WS_PING_INTERVAL=25000
WS_REDIS_ENABLED=false
WS_REDIS_DB=1

# ============================================
# SEEDING (Initial Super Admin)
# ============================================
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_FULL_NAME="Super Admin"
