
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER
// ============================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(255)
  profileImage    String?    @map("profile_image") @db.VarChar(512)

  role            UserRole   @default(EDITOR)
  status          UserStatus @default(INVITED)

  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions        UserSession[]
  tokens          AuthToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  websites        Website[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================
// AUTHENTICATION SESSIONS
// ============================================

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid

  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)

  deviceName       String?   @map("device_name") @db.VarChar(200)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text

  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================
// AUTHENTICATION TOKENS
// ============================================

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  type      TokenType

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid

  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)

  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid

  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")

  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// WEBSITES
// ============================================

model Website {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String        @db.VarChar(255)
  url                 String        @db.VarChar(512)
  restApiUrl          String?       @map("rest_api_url") @db.VarChar(512)
  username            String        @db.VarChar(100)
  applicationPassword String        @map("application_password") @db.Text
  status              WebsiteStatus @default(DISCONNECTED)
  lastError           String?       @map("last_error") @db.Text
  lastSyncAt          DateTime?     @map("last_sync_at")
  isActive            Boolean       @default(true) @map("is_active")

  createdById         String?       @map("created_by_id") @db.Uuid
  createdBy           User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  contentTypes        ContentType[]
  contentSnapshots    ContentSnapshot[]

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([isActive])
  @@index([createdById])
  @@map("websites")
}

// ============================================
// DYNAMIC CONTENT TYPES & REGISTRY
// ============================================

model ContentType {
  id               String                  @id @default(uuid()) @db.Uuid
  websiteId        String                  @map("website_id") @db.Uuid

  slug             String                  @db.VarChar(100)
  name             String                  @db.VarChar(255)
  description      String?                 @db.Text

  restNamespace    String                  @default("wp/v2") @map("rest_namespace") @db.VarChar(100)
  restBase         String                  @map("rest_base") @db.VarChar(150)

  hierarchical     Boolean                 @default(false)
  supports         Json?
  taxonomies       Json?
  schema           Json?
  schemaStatus     ContentTypeSchemaStatus @default(PARTIALLY_DISCOVERED) @map("schema_status")

  isActive         Boolean                 @default(true) @map("is_active")
  lastDiscoveredAt DateTime                @default(now()) @map("last_discovered_at")

  website          Website                 @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  snapshots        ContentSnapshot[]

  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([websiteId, slug])
  @@index([websiteId, isActive])
  @@map("content_types")
}

// ============================================
// CONTENT SNAPSHOTS (ENHANCEMENT WORKFLOW)
// ============================================

model ContentSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  websiteId        String         @map("website_id") @db.Uuid
  contentTypeId    String         @map("content_type_id") @db.Uuid

  wpPostId         Int?           @map("wp_post_id")
  slug             String?        @db.VarChar(255)
  title            String         @db.Text
  rawContent       String?        @map("raw_content") @db.Text
  rawExcerpt       String?        @map("raw_excerpt") @db.Text

  rawDocument      String?        @map("raw_document") @db.Text
  focusKeyword     String?        @map("focus_keyword") @db.VarChar(255)
  metaDescription  String?        @map("meta_description") @db.Text

  wpStatus         String         @default("draft") @map("wp_status") @db.VarChar(50)
  wpUrl            String?        @map("wp_url") @db.VarChar(512)
  wpPublishedAt    DateTime?      @map("wp_published_at")
  wpModifiedAt     DateTime?      @map("wp_modified_at")

  featuredMediaId  Int?           @map("featured_media_id")
  featuredMediaUrl String?        @map("featured_media_url") @db.VarChar(512)

  originalData     Json?          @map("original_data")
  taxonomiesData   Json?          @map("taxonomies_data")
  customFields     Json?          @map("custom_fields")

  workflowStatus   WorkflowStatus @default(IMPORTED) @map("workflow_status")

  website          Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  contentType      ContentType    @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([websiteId, wpPostId])
  @@index([websiteId, workflowStatus])
  @@index([contentTypeId])
  @@map("content_snapshots")
}

// ============================================
// ENUMS
// ============================================

enum ContentTypeSchemaStatus {
  FULLY_DISCOVERED
  PARTIALLY_DISCOVERED
  UNAVAILABLE
}

enum WorkflowStatus {
  IMPORTED
  ANALYZING
  ANALYSIS_COMPLETED
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum WebsiteStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  REVIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum NotificationType {
  SYSTEM
  ARTICLE
  APPROVAL
  PUBLISHING
  SECURITY
}
